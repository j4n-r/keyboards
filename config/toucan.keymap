#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM  1
#define NUM  2
#define GUI  3
#define NAV  4

/* Match the QMK/Vial mod-tap behavior and global 200 ms tapping term. */
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    behaviors {
        /*
         * The active Vial tap dances use 120 ms and only tap + hold actions.
         * Vial resolves an interrupted dance as a tap. Toucan2 has physical
         * key positions 0..41, so the intentionally nonexistent position 42
         * makes every real-key interrupt resolve as tap, while an uninterrupted
         * 120 ms hold resolves as hold.
         */
        vial_td_mod: vial_td_mod_120 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <42>;
            display-name = "Vial TD Mod 120";
        };

        vial_td_layer: vial_td_layer_120 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <120>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <42>;
            display-name = "Vial TD Layer 120";
        };
    };

    keymap {
        compatible = "zmk,keymap";
        base {
            display-name = "BASE";
            bindings = <
                // Row 1
                &bt BT_CLR    &kp Q    &vial_td_layer 4 W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &bt BT_NXT
                // Row 2
                &kp BSPC    &vial_td_mod LGUI A    &vial_td_mod LALT S    &vial_td_mod RCTRL D    &vial_td_mod LSHIFT F    &kp G    &kp H    &vial_td_mod RSHIFT J    &vial_td_mod RCTRL K    &vial_td_mod LALT L    &vial_td_mod RGUI SEMI    &kp SQT
                // Row 3
                &kp CAPSLOCK    &kp Z    &kp X    &kp C    &vial_td_layer 4 V    &kp B    &kp N    &kp M    &kp COMMA    &kp DOT    &kp FSLH    &kp CAPSLOCK
                // Thumbs
                &kp TAB    &mo 1    &kp SPACE    &kp ENTER    &mo 2    &kp ESC
            >;
        };

        symbols {
            display-name = "SYM";
            bindings = <
                // Row 1
                &none    &none    &kp LS(COMMA)    &kp LS(DOT)    &kp GRAVE    &kp KP_DOT    &kp LS(N7)    &kp LS(MINUS)    &kp LBKT    &kp RBKT    &none    &none
                // Row 2
                &none    &kp LS(N1)    &mt LALT KP_MINUS    &mt LCTRL KP_PLUS    &mt LSHIFT KP_EQUAL    &kp LS(N3)    &kp LS(BSLH)    &kp LS(SEMI)    &kp LS(N9)    &kp LS(N0)    &kp LS(N5)    &none
                // Row 3
                &none    &none    &kp KP_SLASH    &kp KP_ASTERISK    &kp LS(N6)    &kp BSLH    &kp LS(GRAVE)    &kp LS(N4)    &kp LS(LBKT)    &kp LS(RBKT)    &kp LS(N2)    &none
                // Thumbs
                &kp ESC    &mo 1    &kp SPACE    &kp ENTER    &mo 4    &kp RALT
            >;
        };

        numbers {
            display-name = "NUM";
            bindings = <
                // Row 1
                &kp FSLH    &kp LS(EQUAL)    &kp N9    &kp N8    &kp N7    &kp COMMA    &kp KP_COMMA    &kp F7    &kp F8    &kp F9    &kp F12    &none
                // Row 2
                &kp BSPC    &mt LGUI MINUS    &mt LALT N3    &mt LCTRL N2    &mt LSHIFT N1    &kp N0    &kp KP_N0    &mt RSHIFT F1    &mt RCTRL F2    &mt RALT F3    &mt RGUI F11    &none
                // Row 3
                &kp KP_NUMLOCK    &kp LS(N8)    &kp N6    &kp N5    &kp N4    &kp DOT    &kp KP_DOT    &kp F4    &kp F5    &kp F6    &kp F10    &none
                // Thumbs
                &kp TAB    &mo 3    &kp SPACE    &kp ENTER    &mo 2    &kp ESC
            >;
        };

        gui {
            display-name = "GUI";
            bindings = <
                // Row 1
                &none    &none    &kp LS(LG(N9))    &kp LS(LG(N8))    &kp LS(LG(N7))    &none    &none    &kp LG(N7)    &kp LG(N8)    &kp LG(N9)    &none    &none
                // Row 2
                &none    &none    &kp LS(LG(N3))    &kp LS(LG(N2))    &kp LS(LG(N1))    &none    &kp LG(H)    &kp LG(N1)    &kp LG(N2)    &kp LG(N3)    &kp LG(L)    &none
                // Row 3
                &none    &none    &kp LS(LG(N6))    &kp LS(LG(N5))    &kp LS(LG(N4))    &none    &none    &kp LG(N4)    &kp LG(N5)    &kp LG(N6)    &none    &none
                // Thumbs
                &none    &none    &none    &none    &none    &none
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                // Row 1
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp LBKT    &trans    &kp SEMI    &trans    &trans
                // Row 2
                &kp BSPC    &kp SQT    &kp MINUS    &trans    &trans    &trans    &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT    &trans    &trans
                // Row 3
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                // Thumbs
                &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};
